<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Account Tax Form View - Add FBR Tax Calculation Type -->
    <record id="view_tax_form_fbr_inherit" model="ir.ui.view">
        <field name="name">account.tax.form.fbr.inherit</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_type']" position="after">
                <field name="fbr_tax_type"/>
            </xpath>
        </field>
    </record>

</odoo>
