<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice Form View - Add FBR fields to invoice lines -->
    <record id="view_move_form_fbr_lines" model="ir.ui.view">
        <field name="name">account.move.form.fbr.lines</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Add FBR metadata and 3rd Schedule Retail fields to invoice line list -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="after">
                <field name="fbr_hs_code" optional="hide"/>
                <field name="fbr_uom_id" optional="hide"/>
                <field name="fbr_sro_id" optional="hide"/>
                <field name="fbr_sro_item_serial_id" optional="hide"/>
                <field name="fbr_fixed_notified_value" optional="hide"/>
                <field name="fbr_retail_price_inc" string="Retail MRP (Inc. ST)" optional="show"/>
                <field name="fbr_retail_unit_tax" string="Unit ST (18%)" optional="show"/>
                <field name="fbr_retail_price_excl" string="Retail Excl. ST" optional="show"/>
                <field name="fbr_sales_tax_withheld_id" optional="hide"/>
                <field name="fbr_extra_tax_id" optional="hide"/>
                <field name="fbr_further_tax_id" optional="hide"/>
                <field name="fbr_fed_payable_id" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']"
                position="after">
                <field name="fbr_line_sales_tax" string="Sales Tax (18%)" optional="show"/>
                <field name="fbr_line_extra_tax" string="Extra Tax (4%)" optional="hide"/>
                <field name="fbr_line_value_inc_st" string="Value Inc. of ST" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
